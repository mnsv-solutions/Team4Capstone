{
  "name": "credit-pulse",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "credit-pulse/backend",
    "credit-pulse/frontend"
  ],
  "scripts": {
    "start:dev:backend": "npm run start:dev --workspace=credit-pulse/backend",
    "start:dev:frontend": "npm run dev --workspace=credit-pulse/frontend",
    "start:dev": "concurrently \"npm run start:dev:backend\" \"npm run start:dev:frontend\""
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
